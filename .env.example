# PremShop configuration. Copy to .env and fill in; .env is gitignored.
# Every variable the application reads is documented here — if code reads a new
# variable, it gets a line here in the same commit.
# Format: KEY=value, one per line. Comments live on their own line.

# --- Django core (S1) ---
# config.settings.dev locally, config.settings.prod on servers.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Never true on a server.
DEBUG=true
# Comma-separated hostnames this app may serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (S1) ---
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://premshop:premshop@localhost:5432/premshop

# --- Redis (arrives with S2 rate limiting / S6 Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Error tracking (S1 wires the SDK; the GlitchTip backend arrives at S6b) ---
# Leave empty until then — the SDK stays silent with no DSN. See ADR-0015.
SENTRY_DSN=

# --- Credential encryption (used from S4a; real key + offline escrow are a hard
# --- gate before any real delivery — see ADR-0007) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Email / transactional relay (ADR-0022) ---
# Email is the login system, so these are money/auth-path settings.
# Backend: omit locally to keep console output; set the SMTP backend to send for real.
#   django.core.mail.backends.console.EmailBackend   (dev default)
#   django.core.mail.backends.smtp.EmailBackend      (prod default)
EMAIL_BACKEND=
EMAIL_HOST=mail-eu.smtp2go.com
# 2525 is the default and is reachable from Iran. If a host blocks it, work down:
# 2525 -> 8025 -> 587 (all STARTTLS), then 465 -> 8465 -> 443 (implicit TLS).
# Never port 25. Do NOT set EMAIL_USE_TLS/EMAIL_USE_SSL — base.py derives both
# from EMAIL_PORT so the two can never be true at once.
EMAIL_PORT=2525
# SMTP2GO > Sending > SMTP Users. Not the account login.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Seconds. Django's own default is None, i.e. a hung relay pins a worker forever.
EMAIL_TIMEOUT=10
# The name this app announces over SMTP (EHLO) and stamps into Message-ID. Without it
# Django uses the machine's own hostname, which leaks it into every customer's inbox.
EMAIL_HELO_NAME=premshop.ir
# Must be a mailbox at premshop.ir, the SMTP2GO-verified sender domain; prod refuses
# to start otherwise. support@ has working inbound forwarding, so replies are read.
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# --- Later steps, documented ahead so nothing is invented ad hoc ---
# TELEGRAM_BOT_TOKEN / TELEGRAM_WEBHOOK_PATH / TELEGRAM_WEBHOOK_SECRET   (S6)
# OPERATOR_TELEGRAM_CHAT_ID / OPERATOR_ALERT_EMAIL   (S6)
# HEARTBEAT_URL   (S6, external dead-man monitor)
