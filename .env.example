# PremShop configuration — copy to .env and fill in. Every variable the app reads is documented here.
# .env is gitignored; no real value ever enters version control.

# --- Django core (S1) ---
DJANGO_SETTINGS_MODULE=config.settings.dev   # config.settings.prod on servers
SECRET_KEY=                                  # generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=true                                   # never true in prod
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Databases (S1) ---
DATABASE_URL=postgres://premshop:premshop@localhost:5432/premshop
REDIS_URL=redis://localhost:6379/0

# --- Observability (S1; backend arrives at S6b — leave empty until then, the SDK no-ops) ---
SENTRY_DSN=                                  # GlitchTip DSN once self-hosted (ADR-0015)

# --- Credential encryption (S4a uses it; REAL key + offline escrow are a hard gate at S6b, ADR-0007) ---
FIELD_ENCRYPTION_KEY=                        # Fernet key; dev: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Later steps (documented ahead so nothing is invented ad hoc) ---
# EMAIL_* =            # S2 — chosen Iranian transactional provider (open-questions #1)
# TELEGRAM_BOT_TOKEN=  # S6
# TELEGRAM_WEBHOOK_PATH=/ TELEGRAM_WEBHOOK_SECRET=   # S6
# OPERATOR_TELEGRAM_CHAT_ID= / OPERATOR_ALERT_EMAIL= # S6
# HEARTBEAT_URL=       # S6 — external dead-man monitor
