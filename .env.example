# PremShop configuration. Copy to .env and fill in; .env is gitignored.
# Every variable the application reads is documented here — if code reads a new
# variable, it gets a line here in the same commit.
# Format: KEY=value, one per line. Comments live on their own line.

# --- Django core (S1) ---
# config.settings.dev locally, config.settings.prod on servers.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Never true on a server.
DEBUG=true
# Comma-separated hostnames this app may serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (S1) ---
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://premshop:premshop@localhost:5432/premshop

# --- Redis (arrives with S2 rate limiting / S6 Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Error tracking (S1 wires the SDK; the GlitchTip backend arrives at S6b) ---
# Leave empty until then — the SDK stays silent with no DSN. See ADR-0015.
SENTRY_DSN=

# --- Credential encryption (used from S4a; real key + offline escrow are a hard
# --- gate before any real delivery — see ADR-0007) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Later steps, documented ahead so nothing is invented ad hoc ---
# EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD   (S2)
# TELEGRAM_BOT_TOKEN / TELEGRAM_WEBHOOK_PATH / TELEGRAM_WEBHOOK_SECRET   (S6)
# OPERATOR_TELEGRAM_CHAT_ID / OPERATOR_ALERT_EMAIL   (S6)
# HEARTBEAT_URL   (S6, external dead-man monitor)
