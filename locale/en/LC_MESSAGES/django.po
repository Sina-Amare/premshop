msgstr "The shop has been on holiday since %(day)s, %(hour)s, and delivery deadlines are not running."

msgid "مدت تعطیلی تا الان"
msgstr "Holiday so far"

msgid "مهلت تحویل: %(left)s، تا پایان تعطیلی نمی‌گذرد"
msgstr "Delivery deadline: %(left)s, not running until the holiday ends"

msgid "مهلتشان تا پایان تعطیلی شروع نمی‌شود"
msgstr "Their deadlines start when the holiday ends"

msgid "نزدیک‌ترین مهلت"
msgstr "Nearest deadline"

msgid "نزدیک‌ترین مهلت پس از پایان (تخمینی)"
msgstr "Nearest deadline after the end (estimate)"


msgid "حداکثر حجم تصویر ۵ مگابایت است."
msgstr "The maximum image size is 5 MB."

msgid "بخش آخر نشانی با حروف لاتین، مثل «ai»."
msgstr "Last part of the URL in Latin letters, for example “ai”."

msgid "مثل ‎#10a37f‎. خالی یعنی رنگ خنثی."
msgstr "For example #10a37f. Leave blank for a neutral colour."

msgid "از ۱ تا ۴۸ ساعت."
msgstr "From 1 to 48 hours."

msgid "جایگزین «تحویل تا … ساعت» در سایت. مهلت تحویل عوض نمی‌شود."
msgstr "Replaces “Delivery within … hours” on the site. The delivery deadline stays the same."

msgid "یادداشت داخلی کنار فرم تحویل."
msgstr "Internal note beside the delivery form."

