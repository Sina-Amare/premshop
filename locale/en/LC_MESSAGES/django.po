msgstr "The customer does not see this."

msgid "قیمت فروش"
msgstr "Sale price (toman)"

msgid "قیمت تخفیفی"
msgstr "Discounted price (toman)"

msgid "باید از قیمت فروش کمتر باشد."
msgstr "Must be lower than the sale price."

msgid "خالی یعنی همین حالا."
msgstr "Empty means now."

msgid "با تعیین تاریخ، روی سایت شمارش معکوس نمایش داده می‌شود. خالی یعنی بدون پایان."
msgstr "With a date, the site shows a countdown. Empty means no end."

msgid "تیک را بردارید تا خریدنی نباشد. پاکش نکنید."
msgstr "Untick to stop selling it. Do not delete it."

msgid "۱ یعنی مشتری تعداد نمی‌بیند."
msgstr "1 means the customer sees no quantity."

msgid "برای فعال‌سازی چیزی از مشتری لازم است؟"
msgstr "Does activation need anything from the customer?"

# Persian quoted inside English is wrapped in U+2068 and U+2069, invisible
# isolates, so the bidi algorithm keeps it in order inside the sentence.
msgid "عبارت کوتاه، نه جمله. روی سایت می‌آید: برای فعال‌سازی، … را می‌پرسیم. مثل: ایمیل اکانت Spotify"
msgstr "A short phrase, not a sentence. The site prints: ⁨برای فعال‌سازی، … را می‌پرسیم.⁩ Like: ⁨ایمیل اکانت Spotify⁩"

msgid "عبارت کوتاه؛ مثل: ایمیل اکانت Spotify."
msgstr "A short label, such as Spotify account email."

msgid "مهلت تحویل باید بین ۱ تا ۷۲ ساعت باشد."
msgstr "The delivery deadline must be between 1 and 72 hours."

msgid "وضعیت محصول معتبر نیست."
msgstr "The product status is not valid."

msgid "قیمت تخفیفی باید بیشتر از صفر و کمتر از قیمت فروش باشد."
msgstr "The discount price must be above zero and below the sale price."

msgid "شروع تخفیف باید قبل از پایان آن باشد."
msgstr "A discount must start before it ends."

msgid "قیمت خرید و قیمت فروش نمی‌توانند منفی باشند."
msgstr "The cost price and the sale price cannot be negative."

msgid "مدت پلن باید دست‌کم یک روز باشد، یا خالی برای بی‌پایان."
msgstr "A plan lasts at least one day, or leave it empty for no end."

msgid "حداکثر تعداد باید بین ۱ تا ۱۰ باشد."
msgstr "The most per order must be between 1 and 10."

msgid "پلنی که به اطلاعات مشتری نیاز دارد، در هر سفارش فقط یکی قابل خرید است."
msgstr "A plan that needs customer details can be bought only once per order."

msgid "نام محصول لاتین نیست، پس نامک را خودتان بنویسید، مثل «chatgpt-plus»."
msgstr "The product name is not in Latin letters, so write the slug yourself, like “chatgpt-plus”."

