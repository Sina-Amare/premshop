msgstr "Official source links, one per line. Only visible in the panel."

msgid "برای محصول با امکانات یا قیمت متغیر. پیش از انتشار، بررسی در ۷ روز اخیر لازم است."
msgstr "For products with changing features or prices. A check within the past 7 days is required to publish."

msgid "فقط در پنل، برای محاسبه‌ی سود فروش."
msgstr "Only visible in the panel. Used to calculate profit on sales."

msgid "فقط در پنل، برای تهیه‌ی محصول."
msgstr "Only visible in the panel. Used to source the product."

msgid "خالی = شروع فوری"
