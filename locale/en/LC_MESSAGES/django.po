msgid "یادداشت خودتان. فعلاً جایی فرستاده نمی‌شود."
msgstr "Your own note. Not sent anywhere yet."

msgid "پیش‌نویس و ناموجود روی سایت دیده نمی‌شوند."
msgstr "Draft and unavailable products are not shown on the site."

msgid "کنار نام محصول، بالای صفحه‌ی محصول می‌آید."
msgstr "Shown beside the product name, at the top of the product page."

msgid "برای گیفت کارت خالی بگذارید."
msgstr "Leave empty for a gift card."

msgid "قیمت خرید"
msgstr "Cost price (toman)"

