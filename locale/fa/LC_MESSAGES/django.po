msgstr "{name} «{obj}» ذخیره شد. حالا می‌توانید {name} دیگری بیفزایید."

msgid "The %(name)s “%(obj)s” was deleted successfully."
msgstr "%(name)s «%(obj)s» حذف شد."

# Ctrl+K's count under its results. The msgid is Unfold's template text as it
# stands, indentation included. The timing is left out: it tells an operator
# nothing.
msgid ""
"\n"
"            Found <span class=\"font-medium text-important\">%(counter)s</span> "
"result in %(time)s seconds\n"
"        "
msgid_plural ""
"\n"
"            Found <span class=\"font-medium text-important\">%(counter)s</span> "
"results in %(time)s seconds\n"
"        "
msgstr[0] "<span class=\"font-medium text-important\">%(counter)s</span> نتیجه"
msgstr[1] "<span class=\"font-medium text-important\">%(counter)s</span> نتیجه"

# Django joins a list of changed fields with this. Its own Persian has no
# space after the comma: «نام،توضیح کوتاه و قیمت فروش».
msgid ", "
msgstr "، "

# On the panel's sign-in page, for a customer already signed in. Django's own
# Persian ran words together («نداریدو»). The address is Latin, so it is isolated.
msgid "You are authenticated as %(username)s, but are not authorized to access this page. Would you like to login to a different account?"
msgstr "با ⁨%(username)s⁩ وارد شده‌اید و این حساب به پنل مدیریت دسترسی ندارد. با حساب دیگری وارد شوید."

# The panel's icon-only controls are named by these (static/js/admin.js reads
# the add link's title). Django's own Persian says «اضافه‌کردن».
msgid "Add %(name)s"
msgstr "افزودن %(name)s"

msgid "Image preview"
msgstr "پیش‌نمایش تصویر"
