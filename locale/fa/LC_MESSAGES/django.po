msgid "برچسب HTML اجرا نمی‌شود و همان‌طور که نوشته شده دیده می‌شود."
msgstr "کد HTML اینجا اجرا نمی‌شه و به شکل متن نمایش داده می‌شه."

msgid "عدد کوچک‌تر، بالاتر."
msgstr "عدد کمتر، بالاتر نمایش داده می‌شه."

msgid "شکل‌هایی که مشتری ممکن است بنویسد، با ویرگول: چت جی‌پی‌تی، چت جیپت، gpt"
msgstr "اسم‌هایی که مشتری ممکنه جستجو کنه رو با ویرگول جدا کنید؛ مثل چت جی‌پی‌تی، چت جیپت، ⁦gpt⁩."

msgid "بین ۱ تا ۷۲ ساعت. دست‌بالا بنویسید."
msgstr "بین ۱ تا ۷۲ ساعت؛ زمان تحویل رو با کمی حاشیه‌ی اطمینان بنویسید."

msgid "اگر پر کنید، مشتری همین متن را همان‌طور که نوشته‌اید به‌جای «تحویل تا … ساعت» می‌بیند."
msgstr "اگه این بخش رو پر کنید، مشتری همین متن رو به‌جای «تحویل تا … ساعت» می‌بینه."

msgid "روی صفحه‌ی محصول می‌نویسیم که تمدید می‌شود."
msgstr "با روشن کردن این گزینه، امکان تمدید روی صفحه‌ی محصول نمایش داده می‌شه."

msgid "یادداشت خودتان. فعلاً جایی فرستاده نمی‌شود."
msgstr "این یادداشت فقط برای خودتونه؛ فعلاً برای مشتری فرستاده نمی‌شه."

msgid "پیش‌نویس و ناموجود روی سایت دیده نمی‌شوند."
msgstr "محصول پیش‌نویس یا ناموجود روی سایت نمایش داده نمی‌شه."

msgid "کنار نام محصول، بالای صفحه‌ی محصول می‌آید."
msgstr "این ویژگی کنار نام محصول، بالای صفحه نمایش داده می‌شه."

msgid "برای گیفت کارت خالی بگذارید."
msgstr "برای گیفت کارت، این بخش رو خالی بذارید."

msgid "مشتری این را نمی‌بیند."
msgstr "این اطلاعات فقط توی پنل دیده می‌شه؛ مشتری بهش دسترسی نداره."

msgid "باید از قیمت فروش کمتر باشد."
msgstr "قیمت با تخفیف باید از قیمت فروش کمتر باشه."

msgid "خالی یعنی همین حالا."
msgstr "اگه خالی بذارید، تخفیف همین الان شروع می‌شه."

msgid "با تعیین تاریخ، روی سایت شمارش معکوس نمایش داده می‌شود. خالی یعنی بدون پایان."
msgstr "زمان پایان، شمارش معکوس رو فعال می‌کنه. خالی یعنی تخفیف بدون زمان پایان."

msgid "تیک را بردارید تا خریدنی نباشد. پاکش نکنید."
msgstr "برای توقف فروش این پلن، تیک «موجود» رو بردارید؛ لازم نیست پلن رو حذف کنید."

msgid "۱ یعنی مشتری تعداد نمی‌بیند."
msgstr "اگه عدد ۱ باشه، انتخاب تعداد به مشتری نمایش داده نمی‌شه."

msgid "برای فعال‌سازی چیزی از مشتری لازم است؟"
msgstr "برای فعال‌سازی این پلن به اطلاعات مشتری نیاز دارید؟"

msgid "عبارت کوتاه، نه جمله. روی سایت می‌آید: برای فعال‌سازی، … را می‌پرسیم. مثل: ایمیل اکانت Spotify"
msgstr "کوتاه بنویسید، مثل «ایمیل اکانت Spotify»؛ مشتری همین عبارت رو توی توضیح فعال‌سازی می‌بینه."

msgid "مهلت تحویل باید بین ۱ تا ۷۲ ساعت باشد."
msgstr "زمان تحویل باید بین ۱ تا ۷۲ ساعت باشه."

msgid "وضعیت محصول معتبر نیست."
msgstr "یکی از وضعیت‌های موجود رو انتخاب کنید."

msgid "قیمت تخفیفی باید بیشتر از صفر و کمتر از قیمت فروش باشد."
msgstr "قیمت با تخفیف باید بیشتر از صفر و کمتر از قیمت فروش باشه."

msgid "شروع تخفیف باید قبل از پایان آن باشد."
msgstr "زمان شروع تخفیف باید قبل از زمان پایانش باشه."

msgid "قیمت خرید و قیمت فروش نمی‌توانند منفی باشند."
msgstr "قیمت خرید و فروش نمی‌تونن منفی باشن."

msgid "مدت پلن باید دست‌کم یک روز باشد، یا خالی برای بی‌پایان."
msgstr "مدت اشتراک باید حداقل یک روز باشه. اگه محدودیت زمانی نداره، این بخش رو خالی بذارید."

msgid "حداکثر تعداد باید بین ۱ تا ۱۰ باشد."
msgstr "حداکثر تعداد باید بین ۱ تا ۱۰ باشه."

msgid "پلنی که به اطلاعات مشتری نیاز دارد، در هر سفارش فقط یکی قابل خرید است."
msgstr "اگه این پلن به اطلاعات مشتری نیاز داره، حداکثر تعداد در هر سفارش باید ۱ باشه."

msgid "نام محصول لاتین نیست، پس نامک را خودتان بنویسید، مثل «chatgpt-plus»."
msgstr "چون نام محصول لاتین نیست، بخش «نام در لینک» رو خودتون با حروف لاتین بنویسید؛ مثل «⁦chatgpt-plus⁩»."

msgid "پلن «%(plan)s» زیر قیمت خرید فروخته می‌شود: %(loss)s زیان در هر فروش."
msgstr "پلن «%(plan)s» زیر قیمت خرید فروخته می‌شه؛ با هر فروش %(loss)s ضرر می‌کنید."

msgid "زیان"
msgstr "ضرر"

msgid "حذف %(object_name)s «%(escaped_object)s» این موردها را هم حذف می‌کند و حساب شما اجازه‌ی حذفشان را ندارد:"
msgstr "با حذف %(object_name)s «%(escaped_object)s»، موارد زیر هم حذف می‌شن؛ اما حسابتون اجازه‌ی حذفشون رو نداره:"

msgid "%(object_name)s «%(escaped_object)s» حذف نمی‌شود، چون این موردها به آن وابسته‌اند:"
msgstr "نمی‌شه %(object_name)s «%(escaped_object)s» رو حذف کرد؛ موارد زیر بهش وابسته‌ان:"

msgid "%(object_name)s «%(escaped_object)s» حذف شود؟ همه‌ی موردهای زیر حذف می‌شوند:"
msgstr "%(object_name)s «%(escaped_object)s» رو حذف می‌کنید؟ تمام موارد زیر هم حذف می‌شن:"

msgid "%(count)s بخش از «%(source)s» به «%(target)s» کپی شد."
msgstr "%(count)s بخش از «%(source)s» روی «%(target)s» کپی شد."

msgid "%(where)s%(field)s: جای خالی «%(marker)s» هنوز پر نشده است."
msgstr "%(where)s%(field)s: جای خالی «%(marker)s» رو کامل کنید."

msgid "Markdown ساده: **پررنگ**، فهرست با - یا ۱.، پیوند، جدول و تیتر ###."
msgstr "متن پررنگ: **متن**، فهرست: - یا ۱.، تیتر: ###. لینک و جدول هم پشتیبانی می‌شه."

msgid "Markdown ساده: پاراگراف، **پررنگ**، پیوند و فهرست. تیتر به متن ساده تبدیل می‌شود."
msgstr "می‌تونید پاراگراف، **متن پررنگ**، لینک و فهرست بنویسید. تیترها به متن ساده تبدیل می‌شن."

msgid "PNG،‏ JPEG یا WebP. هیچ‌وقت اطلاعات ورود اکانت یا داده‌ی مشتری را نشان ندهد."
msgstr "فایل PNG، JPEG یا WebP انتخاب کنید. تصویر نباید اطلاعات ورود اکانت یا اطلاعات مشتری رو نشون بده."

msgid "بخش‌ها روی «%(target)s» کپی نشد، چون منتشر شده است. اول آن را از سایت بردارید."
msgstr "بخش‌ها روی «%(target)s» کپی نشدن، چون محصول منتشر شده. اول اون رو از سایت بردارید."

msgid "«پیش از خرید» کپی نشد، چون «%(target)s» یکی دارد."
msgstr "بخش «قبل از خرید» کپی نشد، چون «%(target)s» همین بخش رو داره."

msgid "آنچه تصویر نشان می‌دهد، برای کسی که آن را نمی‌بیند. با تصویر لازم است."
msgstr "توضیح کوتاه تصویر برای کسی که نمی‌بینه؛ اگه تصویر دارید، این بخش رو هم پر کنید."

msgid "آنچه در پنج نوع بالا نمی‌گنجد."
msgstr "برای محتوایی که توی پنج نوع دیگه جا نمی‌گیره."

msgid "ابعاد تصویر بیشتر از ۲۵ مگاپیکسل است."
msgstr "ابعاد تصویر باید حداکثر ۲۵ مگاپیکسل باشه."

msgid "اصل جواب در جمله‌ی اول، معمولاً یکی دو جمله."
msgstr "جواب اصلی رو همون جمله‌ی اول بنویسید. معمولاً یک یا دو جمله کافیه."

msgid "امکانات یا قیمت ارائه‌دهنده زود عوض می‌شود. انتشار، بررسی در ۷ روز اخیر را لازم دارد."
msgstr "برای سرویس‌های زودتغییر؛ انتشارشون به بررسی اطلاعات توی ۷ روز گذشته نیاز داره."

msgid "اول «این محصول برای شما نیست اگر…»، بعد محدودیت‌ها و آنچه شامل نیست. گارانتی، استثنای بازگشت وجه (اگر باشد) و نکات استفاده را صفحه خودش از فیلدهایشان می‌آورد."
msgstr "اول بگید این محصول برای چه کسی مناسب نیست؛ بعد محدودیت‌ها و مواردی رو بنویسید که شامل نمی‌شه. گارانتی، شرایط خاص بازگشت وجه و نکات استفاده، خودکار از بخش‌های خودشون نمایش داده می‌شن."

msgid "این محصول بخش «پیش از خرید» دارد. همان را ویرایش کنید."
msgstr "این محصول بخش «قبل از خرید» رو داره؛ همون بخش رو ویرایش کنید."

msgid "این محصول حساس به زمان است و ادعاهایش در ۷ روز اخیر بررسی نشده‌اند."
msgstr "اطلاعات این محصول زود تغییر می‌کنه و توی ۷ روز گذشته بررسی نشده. قبل از انتشار، اطلاعاتش رو بررسی کنید."

msgid "با صدای خریدار، همان‌طور که در تلگرام می‌پرسد."
msgstr "سؤال رو همون‌طور بنویسید که مشتری ممکنه توی تلگرام بپرسه."

msgid "بخش‌ها به آخر این محصولات اضافه می‌شوند:"
msgstr "این بخش‌ها به انتهای محتوای محصولات زیر اضافه می‌شن:"

msgid "بیش از ۷ روز پیش، یا هرگز"
msgstr "بررسی‌نشده یا بیش از ۷ روز از بررسی گذشته"

msgid "تا کمبودهای این فرم رفع نشود، منتشر نمی‌شود."
msgstr "برای انتشار محصول، موارد مشخص‌شده توی فرم رو کامل کنید."

msgid "این فایل PNG،‏ JPEG یا WebP نیست، یا خراب است."
msgstr "این فایل سالم نیست یا فرمتش پشتیبانی نمی‌شه. یک تصویر PNG، JPEG یا WebP انتخاب کنید."

msgid "تصویر بدون متن جایگزین ذخیره نمی‌شود."
msgstr "برای ذخیره‌ی تصویر، متن جایگزینش رو هم بنویسید."

msgid "جمع‌بندی یک‌خطی خالی است."
msgstr "معرفی کوتاه محصول رو بنویسید."

msgid "حجم تصویر بیشتر از ۵ مگابایت است."
msgstr "حجم تصویر باید حداکثر ۵ مگابایت باشه."

msgid "منتشرشده، بدون نکات استفاده"
msgstr "منتشرشده و بدون نکات استفاده"

msgid "حساس به زمان، بیش از ۳۰ روز بررسی‌نشده"
msgstr "اطلاعات متغیر؛ بیش از ۳۰ روز بررسی نشده"

msgid "خالی بماند تا نام همین نوع تیتر شود. «متن آزاد» بی‌تیتر می‌ماند."
msgstr "اگه خالی بذارید، نام همین نوع بخش به‌عنوان تیتر نمایش داده می‌شه. «متن آزاد» تیتر نداره."

msgid "روز بررسی نمی‌تواند بعد از امروز باشد."
msgstr "تاریخ بررسی نمی‌تونه بعد از امروز باشه."

msgid "نام فروشگاه را ننویسید. سایت خودش آن را به آخر عنوان اضافه می‌کند."
msgstr "نام فروشگاه رو اینجا ننویسید؛ خودکار به آخر عنوان اضافه می‌شه."

msgid "روزی که ادعاهای متن را دوباره با منبع‌ها سنجیدید."
msgstr "تاریخی که اطلاعات محصول رو دوباره با منابعش بررسی کردید."

msgid "سطر %(line)s نشانی کامل نیست، مثل https://openai.com/chatgpt/pricing"
msgstr "لینک خط %(line)s کامل نیست. نشانی کامل رو وارد کنید؛ مثل ⁦https://openai.com/chatgpt/pricing⁩"

msgid "سه تا پنج فایده، هر کدام به زبان نتیجه و با یک کاربرد واقعی."
msgstr "سه تا پنج مزیت بنویسید. برای هرکدوم توضیح بدید چه کمکی به مشتری می‌کنه و یک مثال واقعی بزنید."

msgid "شرط‌های انتشار برقرار است."
msgstr "محصول برای انتشار آماده‌ست."

msgid "فقط اگر این محصول با قاعده‌ی بازگشت وجه فروشگاه فرق دارد. یک جمله."
msgstr "اگه شرایط بازگشت وجه این محصول با قانون کلی فروشگاه فرق داره، تفاوتش رو توی یک جمله بنویسید."

msgid "فقط بخش‌هایی را بگذارید که به کار این محصول می‌آید و ترتیبشان را با کشیدن عوض کنید. متن سقف کلمه ندارد."
msgstr "فقط بخش‌هایی رو اضافه کنید که برای این محصول لازمه. برای تغییر ترتیب، هر بخش رو بکشید و جابه‌جا کنید. محدودیتی برای تعداد کلمات ندارید."

msgid "قالب بخش را تعیین می‌کند. هر محصول حداکثر یک «پیش از خرید» دارد."
msgstr "نوع محتوای این بخش رو انتخاب کنید. هر محصول فقط یک بخش «قبل از خرید» می‌تونه داشته باشه."

msgid "قدم‌های شماره‌دار از تأیید پرداخت تا اولین استفاده: ما چه می‌کنیم و مشتری چه می‌کند و چه می‌بیند."
msgstr "مراحل بعد از تأیید پرداخت تا اولین استفاده رو شماره‌گذاری کنید؛ بگید شما چه کاری انجام می‌دید و مشتری باید چی کار کنه و چی می‌بینه."

msgid "لوگوی محصول، PNG،‏ JPEG یا WebP. سایت آن را در اندازه‌ی ثابت نشان می‌دهد."
msgstr "لوگوی محصول رو با فرمت PNG، JPEG یا WebP بارگذاری کنید. اندازه‌ی نمایشش روی سایت ثابته."

msgid "محصول منتشرشده با جای خالی پرنشده ذخیره نمی‌شود."
msgstr "قبل از ذخیره‌ی محصول منتشرشده، همه‌ی جای‌خالی‌ها رو کامل کنید."

msgid "نکات استفاده نوشته نشده است. اگر نکته‌ای ندارد، بنویسید «موضوعیت ندارد»."
msgstr "نکات استفاده رو بنویسید. اگه نکته‌ای نداره، عبارت «موضوعیت ندارد» رو وارد کنید."

msgid "هر نکته در یک سطر که با - شروع می‌شود. اگر نکته‌ای ندارد، «موضوعیت ندارد»."
msgstr "هر نکته رو توی یک خط با - شروع کنید. اگه نکته‌ای نیست، عبارت «موضوعیت ندارد» رو بنویسید."

msgid "نشانی صفحه‌های رسمی پشتوانه‌ی ادعاهای متن، هر کدام در یک سطر. روی سایت نمی‌آید."
msgstr "لینک منابع رسمی اطلاعات محصول رو هرکدوم توی یک خط بنویسید. این لینک‌ها به مشتری نمایش داده نمی‌شن."

msgid "نوع بخش معتبر نیست."
msgstr "یکی از نوع‌های موجود رو برای این بخش انتخاب کنید."

msgid "نوع تحویل انتخاب نشده است."
msgstr "نوع تحویل رو انتخاب کنید."

msgid "هر امکان یک سطر، با عدد یا عبارت رسمی ارائه‌دهنده و تاریخ. آنچه نسخه‌ی رایگان دارد در پرانتز همان سطر."
msgstr "هر امکان رو توی یک خط بنویسید؛ همراه با عدد یا عبارت رسمی سرویس و تاریخ بررسی. امکانات نسخه‌ی رایگان رو توی همون خط، داخل پرانتز مشخص کنید."

msgid "هر محصول حداکثر یک بخش «پیش از خرید» دارد."
msgstr "هر محصول فقط یک بخش «قبل از خرید» می‌تونه داشته باشه."

msgid "هیچ محصول دیگری بخش محتوا ندارد."
msgstr "محصول دیگه‌ای با بخش محتوا پیدا نشد."

msgid "هیچ پلن موجودی ندارد."
msgstr "برای انتشار، حداقل یک پلن با وضعیت «موجود» لازمه."

msgid "یک جدول کوچک با تاریخ، فقط جایی که به همین تصمیم کمک می‌کند."
msgstr "یک جدول کوتاه با تاریخ بررسی بنویسید؛ فقط مقایسه‌هایی رو بیارید که به انتخاب مشتری کمک می‌کنن."

msgid "یک جمله: محصول برای خریدار چه می‌کند و به کار چه کسی می‌آید."
msgstr "توی یک جمله بگید این محصول چه کمکی می‌کنه و برای چه کسی مناسبه."

msgid "«%(product)s» تا این‌ها درست نشود، دوباره منتشر نمی‌شود."
msgstr "برای انتشار دوباره‌ی «%(product)s»، این موارد رو اصلاح کنید."

