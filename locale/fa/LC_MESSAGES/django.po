msgstr "قیمت با تخفیف باید بیشتر از صفر و کمتر از قیمت فروش باشد."

msgid "از پلنی که اطلاعات مشتری می‌خواهد، در هر سفارش فقط یکی می‌شود خرید."
msgstr "اگر این پلن به اطلاعات مشتری نیاز دارد، حداکثر تعداد در هر سفارش باید ۱ باشد."

msgid "نام محصول لاتین نیست، پس نامک را خودتان بنویسید، مثل «chatgpt-plus»."
msgstr "چون نام محصول لاتین نیست، بخش «نام در لینک» را خودتان با حروف لاتین بنویسید؛ مثل «⁦chatgpt-plus⁩»."

msgid "پلن «%(plan)s» زیر قیمت خرید فروخته می‌شود: %(loss)s زیان در هر فروش."
msgstr "پلن «%(plan)s» زیر قیمت خرید فروخته می‌شود؛ با هر فروش %(loss)s ضرر می‌کنید."

msgid "زیان"
msgstr "ضرر"

msgid "%(count)s بخش از «%(source)s» به «%(target)s» کپی شد."
msgstr "%(count)s بخش از «%(source)s» روی «%(target)s» کپی شد."

msgid "Markdown ساده: **پررنگ**، فهرست با - یا ۱.، پیوند، جدول و تیتر ###."
msgstr "**پررنگ**، فهرست با - یا ۱.، تیتر با ###؛ لینک و جدول را هم می‌توانید بگذارید."

msgid "Markdown ساده: پاراگراف، **پررنگ**، پیوند و فهرست. تیتر به متن ساده تبدیل می‌شود."
msgstr "می‌توانید پاراگراف، **متن پررنگ**، لینک و فهرست بنویسید. تیترها به متن ساده تبدیل می‌شوند."

msgid "PNG،‏ JPEG یا WebP. هیچ‌وقت اطلاعات ورود اکانت یا داده‌ی مشتری را نشان ندهد."
msgstr "فایل PNG، JPEG یا WebP انتخاب کنید. تصویر نباید اطلاعات ورود اکانت یا اطلاعات مشتری را نشان دهد."

msgid "اول «این محصول برای شما نیست اگر…»، بعد محدودیت‌ها و آنچه شامل نیست. گارانتی، استثنای بازگشت وجه (اگر باشد) و نکات استفاده را صفحه خودش از فیلدهایشان می‌آورد."
msgstr "اول بگویید این محصول برای چه کسی مناسب نیست؛ بعد محدودیت‌ها و مواردی را بنویسید که شامل نمی‌شود. گارانتی، شرایط خاص بازگشت وجه و نکات استفاده، خودکار از بخش‌های خودشان نمایش داده می‌شوند."

msgid "بیش از ۷ روز پیش، یا هرگز"
msgstr "بررسی‌نشده یا بیش از ۷ روز از بررسی گذشته"

msgid "جمع‌بندی یک‌خطی خالی است."
msgstr "معرفی کوتاه محصول را بنویسید."

msgid "منتشرشده، بدون نکات استفاده"
msgstr "منتشرشده و بدون نکات استفاده"

msgid "روزی که ادعاهای متن را دوباره با منبع‌ها سنجیدید."
msgstr "تاریخی که اطلاعات محصول را دوباره با منابع آن بررسی کردید."

msgid "سطر %(line)s نشانی کامل نیست، مثل https://openai.com/chatgpt/pricing"
msgstr "لینک خط %(line)s کامل نیست. نشانی کامل را وارد کنید؛ مثل ⁦https://openai.com/chatgpt/pricing⁩"

msgid "هیچ محصول دیگری بخش محتوا ندارد."
msgstr "محصول دیگری با بخش محتوا پیدا نکردیم."

msgid "هیچ پلن موجودی ندارد."
msgstr "برای انتشار، حداقل یک پلن با وضعیت «موجود» لازم است."

msgid "رنگ را مانند #10a37f وارد کنید."
msgstr "کد رنگ را به شکل ⁦#10a37f⁩ وارد کنید."

msgid "رنگ زمینه‌ی کارت، مانند #10a37f. خالی یعنی زمینه‌ی خنثی."
msgstr "کد رنگ زمینه‌ی کارت را بنویسید؛ مثل ⁦#10a37f⁩. اگر خالی بگذارید، زمینه خنثی می‌ماند."

msgid "This field is required."
msgstr "این قسمت را پر کنید."

msgid "Enter a valid email address."
msgstr "یک آدرس ایمیل معتبر وارد کنید."

msgid "Select %s to change"
msgstr "فهرست %s"

msgid "Select %s to view"
msgstr "فهرست %s"

msgid "Hold down “Control”, or “Command” on a Mac, to select more than one."
msgstr "برای انتخاب چند مورد، کلید ⁨Control⁩ را نگه دارید (در مک، ⁨Command⁩)."

msgid "Add another %(model)s"
msgstr "افزودن %(model)s"

msgid "Change selected %(model)s"
msgstr "ویرایش %(model)s انتخاب‌شده"

msgid "View selected %(model)s"
msgstr "دیدن %(model)s انتخاب‌شده"

msgid "Delete selected %(model)s"
msgstr "حذف %(model)s انتخاب‌شده"

msgid "Successfully deleted %(count)d %(items)s."
msgstr "%(count)d مورد از %(items)s حذف شد."

msgid "Items must be selected in order to perform actions on them. No items have been changed."
msgstr "اول موردهایی را که می‌خواهید انتخاب کنید. چیزی تغییر نکرد."

msgid "No action selected."
msgstr "کاری انتخاب نکرده‌اید."

msgid "Enter a whole number."
msgstr "یک عدد بدون اعشار وارد کنید."

msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "این عدد نباید از %(limit_value)s بیشتر باشد."

msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "این عدد نباید از %(limit_value)s کمتر باشد."

msgid "Ensure this value has at most %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at most %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "این متن نباید بیشتر از %(limit_value)d حرف باشد؛ الان %(show_value)d حرف است."
msgstr[1] "این متن نباید بیشتر از %(limit_value)d حرف باشد؛ الان %(show_value)d حرف است."
