# Persian for the operator panel.
#
# Two jobs. django-unfold ships no locale directory at all, so every string
# it wrote rendered as English in a right-to-left Persian panel. And a few of
# Django's own admin strings are worded differently here — Django's fa locale
# says «گذرواژه» where this shop has said «رمز عبور» everywhere since S2, and
# a test enforces that on the storefront.
#
# The project's own strings are written in Persian in the code and need no
# entry here; locale/en translates them for the panel's English side.
#
# Compile with scripts/compile_messages.py (no gettext needed); a test fails
# if the .mo on disk does not match this file
# (apps/catalog/tests/test_panel_translations.py).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fa\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

