# Secrets & environment — never in version control
.env
.env.*
!.env.example

# Private working state and business material: progress, learning notes, the build
# plan, the product brief (costs, margins, suppliers). It has its own local git
# history; conclusions reach this repository as ADRs in docs/decisions/.
docs-local/

# The owner's own copies of the working kit: the tutor prompt (pasted into a web
# chat, never read from here) and the kit's how-to. Personal, not project files.
tutor.md
HOW-TO-USE.md

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Django (S1+)
staticfiles/
media/

# Frontend: source CSS and the lockfile are tracked; installed packages and
# built output are not (they are reproducible from package-lock.json).
node_modules/
static/css/app.css

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
